# Получите токен у @BotFather и вставьте его сюда.
BOT_TOKEN=123456789:replace_me

# Эти ссылки необязательны на этапе меню. Заполните их перед запуском в продакшене.
WARRANTY_URL=
TERMS_URL=
PRIVACY_URL=

# Админ-панель: https://ваш-домен/admin
# Сгенерируйте длинный случайный ключ и не публикуйте его.
ADMIN_SECRET=change-this-to-a-long-random-secret

# Строка подключения PostgreSQL от Hostless/Neon/Supabase.
# Пример: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# Crypto Pay: токен приложения из @CryptoBot → /pay → My Apps.
# Второе значение — новая длинная случайная строка для адреса webhook.
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_WEBHOOK_SECRET=

